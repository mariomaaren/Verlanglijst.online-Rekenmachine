{
  "manifest_version": 3,
  "name": "Verlanglijst.online Calculator",
  "version": "2.3.0",
  "description": "Shows a live-updating total of all product prices on verlanglijst.online and lets you adjust settings",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon16.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://verlanglijst.online/mijnlijstjes*"],
      "js": ["js/content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{1bff8652-949b-4092-b703-1876cbf23e81}",
      "strict_min_version": "109.0"
    }
  }
}
